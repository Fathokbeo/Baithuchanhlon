<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="600.0" prefWidth="760.0" styleClass="dashboard-root" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="main.client.controller.UserInfoController">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="14.0" styleClass="top-bar">
            <padding>
                <Insets bottom="18.0" left="24.0" right="24.0" top="18.0" />
            </padding>
            <Label styleClass="dashboard-title" text="Thông tin user" />
            <HBox HBox.hgrow="ALWAYS" />
            <Button onAction="#handleBack" text="Quay lại" />
        </HBox>
    </top>
    <center>
        <VBox maxWidth="620.0" spacing="18.0" styleClass="content-panel" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="28.0" left="28.0" right="28.0" top="28.0" />
            </padding>
            <Label styleClass="section-title" text="Thông tin tài khoản" />
            <GridPane hgap="14.0" vgap="14.0">
                <columnConstraints>
                    <ColumnConstraints minWidth="130.0" />
                    <ColumnConstraints hgrow="ALWAYS" />
                </columnConstraints>
                <Label styleClass="label-heading" text="Username" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                <TextField fx:id="usernameField" editable="false" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                <Label styleClass="label-heading" text="Tên hiển thị" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                <TextField fx:id="displayNameField" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                <Label styleClass="label-heading" text="Vai trò" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                <TextField fx:id="roleField" editable="false" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                <Label styleClass="label-heading" text="Số dư" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                <TextField fx:id="balanceField" editable="false" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                <Label styleClass="label-heading" text="Email" GridPane.columnIndex="0" GridPane.rowIndex="4" />
                <TextField fx:id="emailField" promptText="Nhap email" GridPane.columnIndex="1" GridPane.rowIndex="4" />
                <Label styleClass="label-heading" text="Số điện thoại" GridPane.columnIndex="0" GridPane.rowIndex="5" />
                <TextField fx:id="phoneField" promptText="Nhap so dien thoai" GridPane.columnIndex="1" GridPane.rowIndex="5" />
                <Label styleClass="label-heading" text="Địa chỉ" GridPane.columnIndex="0" GridPane.rowIndex="6" />
                <TextArea fx:id="addressField" prefRowCount="4" promptText="Nhap dia chi" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="6" />
            <rowConstraints>
               <RowConstraints />
               <RowConstraints />
               <RowConstraints />
               <RowConstraints />
               <RowConstraints />
               <RowConstraints />
               <RowConstraints />
            </rowConstraints>
            </GridPane>
            <HBox alignment="CENTER_RIGHT" spacing="12.0">
                <Button onAction="#handleBack" text="Hủy" />
                <Button onAction="#handleSave" styleClass="primary-button" text="Lưu thông tin" />
            </HBox>
        </VBox>
    </center>
</BorderPane>
