<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="700.0" prefWidth="560.0" styleClass="login-root" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="main.client.controller.LoginController">
    <top>
        <VBox spacing="10.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="16.0" left="32.0" right="32.0" top="28.0" />
            </padding>
            <Label styleClass="app-title" text="Auction App" />
            <Label styleClass="app-subtitle" text="Nền tảng đấu giá trực tuyến realtime với Java + JavaFX" />
        </VBox>
    </top>
    <center>
        <VBox spacing="18.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="32.0" left="32.0" right="32.0" top="10.0" />
            </padding>
            <TabPane styleClass="glass-tabs" tabClosingPolicy="UNAVAILABLE">
                <tabs>
                    <Tab text="Đăng nhập">
                        <content>
                            <VBox spacing="14.0" styleClass="glass-card">
                                <padding>
                                    <Insets bottom="24.0" left="24.0" right="24.0" top="24.0" />
                                </padding>
                                <Label styleClass="section-title" text="Tài khoản hiện có" />
                                <TextField fx:id="loginUsernameField" onAction="#handleLogin" promptText="Tên đăng nhập" />
                                <PasswordField fx:id="loginPasswordField" onAction="#handleLogin" promptText="Mật khẩu" />
                                <Button fx:id="loginButton" onAction="#handleLogin" styleClass="primary-button" text="Đăng nhập" />
                                <Label styleClass="hint-label" text="Demo: admin/admin123, seller1/seller123, bidder1/bid123" wrapText="true" />
                            </VBox>
                        </content>
                    </Tab>
                    <Tab text="Đăng ký">
                        <content>
                            <VBox spacing="14.0" styleClass="glass-card">
                                <padding>
                                    <Insets bottom="24.0" left="24.0" right="24.0" top="24.0" />
                                </padding>
                                <Label styleClass="section-title" text="Tạo tài khoản bidder hoặc seller" />
                                <TextField fx:id="registerDisplayNameField" promptText="Tên hiển thị" />
                                <TextField fx:id="registerUsernameField" promptText="Tên đăng nhập" />
                                <PasswordField fx:id="registerPasswordField" promptText="Mật khẩu" />
                                <ComboBox fx:id="roleComboBox" />
                                <Button fx:id="registerButton" onAction="#handleRegister" styleClass="primary-button" text="Đăng ký" />
                            </VBox>
                        </content>
                    </Tab>
                </tabs>
            </TabPane>
        </VBox>
    </center>
    <bottom>
        <HBox alignment="CENTER_LEFT" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="28.0" left="32.0" right="32.0" top="0.0" />
            </padding>
            <Label fx:id="statusLabel" styleClass="status-label" />
        </HBox>
    </bottom>
</BorderPane>
